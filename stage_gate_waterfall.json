{
  "archetype": "stage_gate_waterfall",
  "display_name": "Stage Gate Phased Delivery",
  "family": "phased",
  "summary": "Sequential phases separated by formal governance gates for fixed scope and hardware work.",
  "template_version": "2026.10",
