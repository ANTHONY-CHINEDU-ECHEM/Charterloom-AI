{
  "archetype": "regulated_compliance_pipeline",
  "display_name": "Regulated Compliance Pipeline",
  "family": "controlled",
  "summary": "Traceable, signature gated lifecycle for modules subject to strict regulatory oversight.",
  "template_version": "2026.10",
